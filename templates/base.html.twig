<!DOCTYPE html>
<html>
    <head>
       
    </head>
    <body>
      {% block body %}
        <nav>
         {% if is_granted('ROLE_ADMIN') %}
             <p>You are logged in as Admin. You have full access.</p>
             <a href="/user">User Management</a>
             <a href="/product">Activity Logs</a>
         {% endif %}

         {% if is_granted('ROLE_USER') %}
             <p>You are logged in as Regular User. Limited access granted.</p>
         {% endif %}

         <a href="/">Home</a>
         <a href="/product">Products</a>
        </nav>
      {% endblock %}

    </body>
</html>
